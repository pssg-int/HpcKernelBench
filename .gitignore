# ---- kernel-papers: what is deliberately NOT committed ----------------------
# Python / editor noise
__pycache__/
*.pyc
.claude/worktrees/

# Downloaded benchmark data (re-fetched by the loaders in kernelbench/)
annsearch-data/
bench/matrices/
bench/graphs/
bench/annsearch-data/

# Run outputs (every result carries its env block; regenerate, don't version)
bench/results/*.json

# Paper-artifact clones: 5+ GB of third-party repos, each with its own .git.
# Every <short>/ keeps <short>/source.provenance (remote, commit, clone cmd)
# and, where we changed tracked files, <short>/source.patch -- see
# bench/ARTIFACT_GUIDE.md. Re-clone + apply to reproduce.
bench/artifacts/*/*/source/
bench/artifacts/*/*/source_*/

# Build products of artifact adapters (rebuilt by each <short>/build.sh)
bench/artifacts/*/*/vendor/
bench/artifacts/*/*/_build/
bench/artifacts/*/*/build/
bench/artifacts/*/*/cache/
bench/artifacts/*/*/pybuild/
# pip --target dependency trees (tilelang, z3, einops, ...) installed by build.sh
bench/artifacts/*/*/pylibs/
# mp-spmm/adapter.py's own scratch tree: per-run .mtx / preprocessed .bin
# files it writes to feed the artifact's own preprocessing binary (which
# only reads/writes real files on disk, not an in-memory API) -- not part
# of the artifact, regenerated by every prepare() call.
bench/artifacts/spmm/mp-spmm/work/
# mp-spmm's preprocessing tool: a bare executable (no extension), so *.o/*.a
# below don't catch it.
bench/artifacts/spmm/mp-spmm/mpspmm_preprocess
*.so
*.o
*.a
bench/csrc/*.so
bench/csrc/*.o
output/benchmark_status.data.json

# dependency stacks built per artifact (StarPU/Chameleon/NLopt/...) and their install prefixes
bench/artifacts/*/*/deps/
bench/artifacts/*/*/prefix/
bench/artifacts/*/*/*.log
# lazily cloned benchmark automata (ANMLZoo)
bench/automata-data/
# JIT caches and scratch left in the repo root / artifact dirs by builds and gates
.hidet_cache/
bench/artifacts/*/*/work/
bench/*.mtx
bench/*.tar.gz
# built helper executables (rebuilt by build.sh)
bench/artifacts/spmm/generalsparse/gs_emit
# SuiteSparse index download + per-artifact object dirs
bench/ssstats.csv
bench/artifacts/*/*/build_obj/
# fringe-sgc build products (regenerated by its build.sh)
bench/artifacts/graph-pattern-mining/fringe-sgc/fringePreprocess
bench/artifacts/graph-pattern-mining/fringe-sgc/k4.mo
bench/artifacts/graph-pattern-mining/fringe-sgc/k4.dot
# sparse-transformer: setuptools build dir of the pybind shim (product of its build.sh)
bench/artifacts/sparse-attention-kernel/sparse-transformer/_build_binding_attn/build/

# stray StarPU/etc download tree written to repo root by a build.sh run from the
# repo root (exageostat DEPS); build downloads, never committed
/deps/

# Slurm job stdout (transient; durable records live in shared/kernel-bench/h100_logs)
slurm-*.out
**/slurm-*.out
