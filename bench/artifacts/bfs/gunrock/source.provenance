# Provenance of source/ (clone) -- the checkout itself is git-ignored.
# Gunrock "essentials" v2.1.0 (Jul 2024): the last release before the HIP/AMD
# backend became the CMake default, i.e. the CUDA-only version contemporary
# with BLEST's comparison. Header-only; build.sh compiles gunrock_shim.cu
# against include/ directly (no CMake, no FetchContent).
remote=https://github.com/gunrock/gunrock.git
commit=530f25443864d04c25286c053d6812a888b4d779   # tag v2.1.0
reclone=git clone https://github.com/gunrock/gunrock.git source && git -C source checkout 530f25443864d04c25286c053d6812a888b4d779
patch=none
