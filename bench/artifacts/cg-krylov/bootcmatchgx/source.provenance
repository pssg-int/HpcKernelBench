# Provenance of source/ -- SHARED with ../../multigrid/bootcmatchgx/ (this
# is a symlink to that directory's clone, not a second clone). See that
# directory's own source.provenance for the full reclone recipe; repeated
# here for completeness.
remote=https://github.com/bootcmatch/BootCMatchGX.git
commit=420223a88d2dfef8b28571db2c9392c1af8e146c
shared_build_with=../../multigrid/bootcmatchgx
patch=none-here   # our recorded edits (config_mk.patch + vector_print_precision.patch) live in
                  # ../../multigrid/bootcmatchgx/source.patch -- this directory adds no patches of its own,
                  # it reuses the multigrid track's already-patched, already-built binary verbatim.
untracked_in_clone=0
