-void dev_alloc_and_copy(void **dst, size_t size, const void *src = nullptr) {
+// KernelBench integration patch (see ../../../source.patch): `static` added
+// to both of these -- neither was declared `inline`/`static` in the
+// original header, which is harmless when this header is included by only
+// ONE .cu translation unit (the artifact's own normal build) but becomes an
+// ODR violation ("multiple definition") once a second .cu file (this
+// project's gs_shim.cu, needed to launch gpu_clique.cu's own kernel from a
+// separate translation unit) also includes it and both are linked together
+// with `-rdc=true` (relocatable device code, required for gs_shim.cu to
+// reference gpu_clique.cu's __global__/__device__ symbols across TUs --
+// see build.sh). Pure linkage annotation, zero arithmetic/behavior change.
+static void dev_alloc_and_copy(void **dst, size_t size, const void *src = nullptr) {
     gpuErrchk(cudaMalloc(dst, size));
     if (src != nullptr) {
         gpuErrchk(cudaMemcpy(*dst, src, size, cudaMemcpyHostToDevice));
     }
 }
 
