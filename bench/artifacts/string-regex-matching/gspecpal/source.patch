diff --git a/CMakeLists.txt b/CMakeLists.txt
index 5132f48..cb78c0e 100644
--- a/CMakeLists.txt
+++ b/CMakeLists.txt
@@ -9,13 +9,13 @@ SET(VERSION_MAJOR "0")
 SET(VERSION_MINOR "1")
 SET(VERSION_PATCH "0")
 
-set(CMAKE_CXX_STANDARD 11)
+set(CMAKE_CXX_STANDARD 17)
 set(CMAKE_CXX_STANDARD_REQUIRED ON)
 
 if(CMAKE_COMPILER_IS_GNUCXX)
-	set(CMAKE_CXX_FLAGS "${CMAKE_CXX_FLAGS} -O3 -std=c++11") 
+	set(CMAKE_CXX_FLAGS "${CMAKE_CXX_FLAGS} -O3 -std=c++17") 
 endif(CMAKE_COMPILER_IS_GNUCXX)
-set(CUDA_NVCC_FLAGS "${CUDA_NVCC_FLAGS} -std=c++11 -lineinfo --expt-extended-lambda -O3 -Wno-deprecated-gpu-targets")
+set(CUDA_NVCC_FLAGS "${CUDA_NVCC_FLAGS} -std=c++17 -lineinfo --expt-extended-lambda -O3 -Wno-deprecated-gpu-targets")
 
 
 include(FindCUDA)
@@ -26,8 +26,8 @@ Set to Auto for automatic detection (default)."
 )
 #cuda_select_nvcc_arch_flags(CUDA_ARCH_FLAGS ${CUDA_ARCH_LIST})
 #list(APPEND CUDA_NVCC_FLAGS ${CUDA_ARCH_FLAGS})
-string(APPEND CUDA_NVCC_FLAGS " -gencode arch=compute_86,code=sm_86")
-set(CMAKE_CUDA_ARCHITECTURES 86)
+string(APPEND CUDA_NVCC_FLAGS " -gencode arch=compute_80,code=sm_80")
+set(CMAKE_CUDA_ARCHITECTURES 80)
 
 #message(STATUS ${CUDA_NVCC_FLAGS})
 #message(STATUS ${CUDA_ARCH_FLAGS})
